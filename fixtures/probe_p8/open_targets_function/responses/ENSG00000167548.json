{"data":{"target":{"id":"ENSG00000167548","approvedSymbol":"KMT2D","functionDescriptions":["Histone methyltransferase that catalyzes methyl group transfer from S-adenosyl-L-methionine to the epsilon-amino group of 'Lys-4' of histone H3 (H3K4) (PubMed:25561738). Part of chromatin remodeling machinery predominantly forms H3K4me1 methylation marks at active chromatin sites where transcription and DNA repair take place (PubMed:17500065, PubMed:25561738). Acts as a coactivator for estrogen receptor by being recruited by ESR1, thereby activating transcription (PubMed:16603732). {ECO:0000269|PubMed:16603732, ECO:0000269|PubMed:17500065, ECO:0000269|PubMed:25561738}."],"proteinIds":[{"id":"O14686","source":"uniprot_swissprot"},{"id":"A0A3B3ISC8","source":"uniprot_trembl"},{"id":"A0A804HHR9","source":"uniprot_trembl"},{"id":"A0A804HJB5","source":"uniprot_trembl"},{"id":"A0A8I5KNS6","source":"uniprot_trembl"},{"id":"A0A8I5KPB7","source":"uniprot_trembl"},{"id":"A0A8I5KQ09","source":"uniprot_trembl"},{"id":"A0A8I5KQD6","source":"uniprot_trembl"},{"id":"A0A8I5KQT2","source":"uniprot_trembl"},{"id":"A0A8I5KRH2","source":"uniprot_trembl"},{"id":"A0A8I5KSG1","source":"uniprot_trembl"},{"id":"A0A8I5KTR4","source":"uniprot_trembl"},{"id":"A0A8I5KU18","source":"uniprot_trembl"},{"id":"A0A8I5KU33","source":"uniprot_trembl"},{"id":"A0A8I5KU95","source":"uniprot_trembl"},{"id":"A0A8I5KX79","source":"uniprot_trembl"},{"id":"A0A8I5KYU5","source":"uniprot_trembl"},{"id":"A0A8I5QJ79","source":"uniprot_trembl"},{"id":"A0A8I5QJA0","source":"uniprot_trembl"},{"id":"A0A8I5QJD3","source":"uniprot_trembl"},{"id":"A0A8I5QJD5","source":"uniprot_trembl"},{"id":"A0A8I5QJE4","source":"uniprot_trembl"},{"id":"A0A8I5QKN1","source":"uniprot_trembl"},{"id":"A0A8I5QKP3","source":"uniprot_trembl"},{"id":"ENSP00000301067","source":"ensembl_PRO"},{"id":"ENSP00000497218","source":"ensembl_PRO"},{"id":"ENSP00000506726","source":"ensembl_PRO"},{"id":"ENSP00000507433","source":"ensembl_PRO"},{"id":"ENSP0000050861