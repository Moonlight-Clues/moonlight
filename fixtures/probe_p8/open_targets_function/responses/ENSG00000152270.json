{"data":{"target":{"id":"ENSG00000152270","approvedSymbol":"PDE3B","functionDescriptions":["Cyclic nucleotide phosphodiesterase with a dual-specificity for the second messengers cAMP and cGMP, which are key regulators of many important physiological process (PubMed:14592490, PubMed:21393242). Regulates angiogenesis by inhibiting the cAMP- dependent guanine nucleotide exchange factor RAPGEF3 and downstream phosphatidylinositol 3-kinase gamma-mediated signaling (PubMed:21393242). Controls cardiac contractility by reducing cAMP concentration in cardiocytes (By similarity). {ECO:0000250|UniProtKB:Q61409, ECO:0000269|PubMed:14592490, ECO:0000269|PubMed:21393242}."],"proteinIds":[{"id":"Q13370","source":"uniprot_swissprot"},{"id":"ENSP00000282096","source":"ensembl_PRO"},{"id":"ENSP00000388644","source":"ensembl_PRO"},{"id":"ENSP00000540683","source":"ensembl_PRO"},{"id":"ENSP00000540684","source":"ensembl_PRO"},{"id":"ENSP00000540685","source":"ensembl_PRO"},{"id":"ENSP00000540686","source":"ensembl_PRO"},{"id":"ENSP00000540687","source":"ensembl_PRO"},{"id":"ENSP00000540688","source":"ensembl_PRO"},{"id":"ENSP00000540689","source":"ensembl_PRO"},{"id":"ENSP00000540690","source":"ensembl_PRO"},{"id":"ENSP00000601627","source":"ensembl_PRO"},{"id":"ENSP00000601628","source":"ensembl_PRO"},{"id":"ENSP00000635042","source":"ensembl_PRO"},{"id":"ENSP00000635043","source":"ensembl_PRO"},{"id":"ENSP00000635044","source":"ensembl_PRO"},{"id":"ENSP00000673320","source":"ensembl_PRO"},{"id":"ENSP00000673321","source":"ensembl_PRO"},{"id":"ENSP00000673322","source":"ensembl_PRO"},{"id":"ENSP00000687917","source":"ensembl_PRO"},{"id":"ENSP00000687918","source":"ensembl_PRO"},{"id":"ENSP00000781224","source":"ensembl_PRO"},{"id":"ENSP00000789571","source":"ensembl_PRO"},{"id":"ENSP00000804454","source":"ensembl_PRO"},{"id":"B7ZM37","source":"uniprot_obsolete"},{"id":"O00639","source":"uniprot_obsolete"},{"id":"Q14408","source":"uniprot_obsolete"},{"id":"Q6SEI4","source":"uniprot_obs