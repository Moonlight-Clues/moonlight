{"data":{"target":{"id":"ENSG00000106105","approvedSymbol":"GARS1","functionDescriptions":["Catalyzes the ATP-dependent ligation of glycine to the 3'-end of its cognate tRNA, via the formation of an aminoacyl-adenylate intermediate (Gly-AMP) (PubMed:17544401, PubMed:24898252, PubMed:28675565). Also produces diadenosine tetraphosphate (Ap4A), a universal pleiotropic signaling molecule needed for cell regulation pathways, by direct condensation of 2 ATPs. Thereby, may play a special role in Ap4A homeostasis (PubMed:19710017). {ECO:0000269|PubMed:17544401, ECO:0000269|PubMed:19710017, ECO:0000269|PubMed:24898252, ECO:0000269|PubMed:28675565}."],"proteinIds":[{"id":"P41250","source":"uniprot_swissprot"},{"id":"A0A6Q8PF45","source":"uniprot_trembl"},{"id":"A0A6Q8PFN0","source":"uniprot_trembl"},{"id":"A0A6Q8PFU7","source":"uniprot_trembl"},{"id":"A0A6Q8PFV5","source":"uniprot_trembl"},{"id":"A0A6Q8PFZ6","source":"uniprot_trembl"},{"id":"A0A6Q8PGA8","source":"uniprot_trembl"},{"id":"A0A6Q8PGI6","source":"uniprot_trembl"},{"id":"A0A6Q8PGN7","source":"uniprot_trembl"},{"id":"A0A6Q8PGT3","source":"uniprot_trembl"},{"id":"A0A6Q8PGW4","source":"uniprot_trembl"},{"id":"A0A6Q8PGZ8","source":"uniprot_trembl"},{"id":"A0A6Q8PGZ9","source":"uniprot_trembl"},{"id":"A0A6Q8PH49","source":"uniprot_trembl"},{"id":"A0A6Q8PHH9","source":"uniprot_trembl"},{"id":"A0A6Q8PHI7","source":"uniprot_trembl"},{"id":"F8WCK4","source":"uniprot_trembl"},{"id":"H7C443","source":"uniprot_trembl"},{"id":"ENSP00000373918","source":"ensembl_PRO"},{"id":"ENSP00000392677","source":"ensembl_PRO"},{"id":"ENSP00000415447","source":"ensembl_PRO"},{"id":"ENSP00000501636","source":"ensembl_PRO"},{"id":"ENSP00000501655","source":"ensembl_PRO"},{"id":"ENSP00000501884","source":"ensembl_PRO"},{"id":"ENSP00000501980","source":"ensembl_PRO"},{"id":"ENSP00000501986","source":"ensembl_PRO"},{"id":"ENSP00000502033","source":"ensembl_PRO"},{"id":"ENSP00000502174","source":"ensembl_PRO"},{"id":"ENSP00000502296","source":"ens