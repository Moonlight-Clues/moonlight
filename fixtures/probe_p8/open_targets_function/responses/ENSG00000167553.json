{"data":{"target":{"id":"ENSG00000167553","approvedSymbol":"TUBA1C","functionDescriptions":["Tubulin is the major constituent of microtubules, a cylinder consisting of laterally associated linear protofilaments composed of alpha- and beta-tubulin heterodimers. Microtubules grow by the addition of GTP-tubulin dimers to the microtubule end, where a stabilizing cap forms. Below the cap, tubulin dimers are in GDP-bound state, owing to GTPase activity of alpha-tubulin."],"proteinIds":[{"id":"Q9BQE3","source":"uniprot_swissprot"},{"id":"F5H5D3","source":"uniprot_trembl"},{"id":"F8VRK1","source":"uniprot_trembl"},{"id":"F8VS66","source":"uniprot_trembl"},{"id":"H0YHV2","source":"uniprot_trembl"},{"id":"ENSP00000301072","source":"ensembl_PRO"},{"id":"ENSP00000443475","source":"ensembl_PRO"},{"id":"ENSP00000447669","source":"ensembl_PRO"},{"id":"ENSP00000447910","source":"ensembl_PRO"},{"id":"ENSP00000448211","source":"ensembl_PRO"},{"id":"ENSP00000448646","source":"ensembl_PRO"},{"id":"ENSP00000601168","source":"ensembl_PRO"},{"id":"ENSP00000601169","source":"ensembl_PRO"},{"id":"ENSP00000601170","source":"ensembl_PRO"},{"id":"ENSP00000601171","source":"ensembl_PRO"},{"id":"ENSP00000729260","source":"ensembl_PRO"},{"id":"ENSP00000729261","source":"ensembl_PRO"},{"id":"ENSP00000729267","source":"ensembl_PRO"},{"id":"ENSP00000770528","source":"ensembl_PRO"}]}}}