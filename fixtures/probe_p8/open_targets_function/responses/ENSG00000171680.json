{"data":{"target":{"id":"ENSG00000171680","approvedSymbol":"PLEKHG5","functionDescriptions":["Functions as a guanine exchange factor (GEF) for RAB26 and thus regulates autophagy of synaptic vesicles in axon terminal of motoneurons (By similarity). Involved in the control of neuronal cell differentiation (PubMed:11704860). Plays a role in angiogenesis through regulation of endothelial cells chemotaxis. Also affects the migration, adhesion, and matrix/bone degradation in macrophages and osteoclasts (PubMed:23777631). {ECO:0000250|UniProtKB:Q66T02, ECO:0000269|PubMed:11704860, ECO:0000269|PubMed:23777631}."],"proteinIds":[{"id":"O94827","source":"uniprot_swissprot"},{"id":"A0A5F9ZHW8","source":"uniprot_trembl"},{"id":"A0A6Q8PF22","source":"uniprot_trembl"},{"id":"A0A6Q8PG76","source":"uniprot_trembl"},{"id":"A0A6Q8PGZ5","source":"uniprot_trembl"},{"id":"A0A6Q8PHD3","source":"uniprot_trembl"},{"id":"A0A6Q8PHJ1","source":"uniprot_trembl"},{"id":"A0A6Q8PHR5","source":"uniprot_trembl"},{"id":"A0A6Q8PHS0","source":"uniprot_trembl"},{"id":"A0A7I2PMD6","source":"uniprot_trembl"},{"id":"A0A804EMX3","source":"uniprot_trembl"},{"id":"Q5SY18","source":"uniprot_trembl"},{"id":"ENSP00000344570","source":"ensembl_PRO"},{"id":"ENSP00000366954","source":"ensembl_PRO"},{"id":"ENSP00000366957","source":"ensembl_PRO"},{"id":"ENSP00000366961","source":"ensembl_PRO"},{"id":"ENSP00000366969","source":"ensembl_PRO"},{"id":"ENSP00000366977","source":"ensembl_PRO"},{"id":"ENSP00000383704","source":"ensembl_PRO"},{"id":"ENSP00000383706","source":"ensembl_PRO"},{"id":"ENSP00000439625","source":"ensembl_PRO"},{"id":"ENSP00000441445","source":"ensembl_PRO"},{"id":"ENSP00000500749","source":"ensembl_PRO"},{"id":"ENSP00000501611","source":"ensembl_PRO"},{"id":"ENSP00000501842","source":"ensembl_PRO"},{"id":"ENSP00000501925","source":"ensembl_PRO"},{"id":"ENSP00000502132","source":"ensembl_PRO"},{"id":"ENSP00000502459","source":"ensembl_PRO"},{"id":"ENSP00000502684","source":"ensembl_PRO"},{"id":"ENS