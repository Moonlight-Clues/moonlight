{"data":{"target":{"id":"ENSG00000131238","approvedSymbol":"PPT1","functionDescriptions":["Has thioesterase activity against fatty acid thioesters with 14 -18 carbons, including palmitoyl-CoA, S-palmitoyl-N- acetylcysteamine, and palmitoylated proteins (PubMed:12855696, PubMed:26731412, PubMed:8816748). In contrast to PPT2, PPT1 can hydrolyze palmitoylated proteins and palmitoylcysteine (PubMed:12855696). {ECO:0000269|PubMed:12855696, ECO:0000269|PubMed:26731412, ECO:0000269|PubMed:8816748}."],"proteinIds":[{"id":"P50897","source":"uniprot_swissprot"},{"id":"A0A286YEP3","source":"uniprot_trembl"},{"id":"A0A286YF39","source":"uniprot_trembl"},{"id":"A0A286YFE3","source":"uniprot_trembl"},{"id":"A0A286YFF7","source":"uniprot_trembl"},{"id":"A0A286YFL6","source":"uniprot_trembl"},{"id":"A0A286YFL8","source":"uniprot_trembl"},{"id":"A0A2C9F2P4","source":"uniprot_trembl"},{"id":"E9PIA8","source":"uniprot_trembl"},{"id":"E9PK48","source":"uniprot_trembl"},{"id":"E9PMG2","source":"uniprot_trembl"},{"id":"E9PP28","source":"uniprot_trembl"},{"id":"E9PSE5","source":"uniprot_trembl"},{"id":"Q5T0S4","source":"uniprot_trembl"},{"id":"ENSP00000361865","source":"ensembl_PRO"},{"id":"ENSP00000392293","source":"ensembl_PRO"},{"id":"ENSP00000394863","source":"ensembl_PRO"},{"id":"ENSP00000403207","source":"ensembl_PRO"},{"id":"ENSP00000431655","source":"ensembl_PRO"},{"id":"ENSP00000432053","source":"ensembl_PRO"},{"id":"ENSP00000434007","source":"ensembl_PRO"},{"id":"ENSP00000436481","source":"ensembl_PRO"},{"id":"ENSP00000436695","source":"ensembl_PRO"},{"id":"ENSP00000492910","source":"ensembl_PRO"},{"id":"ENSP00000492984","source":"ensembl_PRO"},{"id":"ENSP00000493063","source":"ensembl_PRO"},{"id":"ENSP00000493128","source":"ensembl_PRO"},{"id":"ENSP00000493146","source":"ensembl_PRO"},{"id":"ENSP00000493153","source":"ensembl_PRO"},{"id":"ENSP00000493359","source":"ensembl_PRO"},{"id":"ENSP00000493369","source":"ensembl_PRO"},{"id":"ENSP00000587821","source":"ensembl_PRO"},{"id