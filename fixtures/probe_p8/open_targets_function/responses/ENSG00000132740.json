{"data":{"target":{"id":"ENSG00000132740","approvedSymbol":"IGHMBP2","functionDescriptions":["5' to 3' helicase that unwinds both RNA and DNA duplexes in an ATP-dependent reaction (Probable) (PubMed:19158098, PubMed:30218034). Specific to 5'-phosphorylated single-stranded guanine-rich sequences (PubMed:22999958, PubMed:8349627). May play a role in RNA metabolism, ribosome biogenesis or initiation of translation (PubMed:19158098, PubMed:19299493). May play a role in regulation of transcription (By similarity). Interacts with tRNA-Tyr (PubMed:19299493). Has low processivity (PubMed:30218034). {ECO:0000250|UniProtKB:Q9EQN5, ECO:0000269|PubMed:19158098, ECO:0000269|PubMed:19299493, ECO:0000269|PubMed:22999958, ECO:0000269|PubMed:30218034, ECO:0000269|PubMed:8349627, ECO:0000305|PubMed:22965130}."],"proteinIds":[{"id":"P38935","source":"uniprot_swissprot"},{"id":"A0A6Q8PEZ5","source":"uniprot_trembl"},{"id":"A0A6Q8PF00","source":"uniprot_trembl"},{"id":"A0A6Q8PF01","source":"uniprot_trembl"},{"id":"A0A6Q8PF41","source":"uniprot_trembl"},{"id":"A0A6Q8PFK9","source":"uniprot_trembl"},{"id":"A0A6Q8PFN4","source":"uniprot_trembl"},{"id":"A0A6Q8PFP3","source":"uniprot_trembl"},{"id":"A0A6Q8PFZ7","source":"uniprot_trembl"},{"id":"A0A6Q8PGC0","source":"uniprot_trembl"},{"id":"A0A6Q8PGF6","source":"uniprot_trembl"},{"id":"A0A6Q8PGQ2","source":"uniprot_trembl"},{"id":"A0A6Q8PGQ6","source":"uniprot_trembl"},{"id":"A0A6Q8PGT6","source":"uniprot_trembl"},{"id":"A0A6Q8PGX2","source":"uniprot_trembl"},{"id":"A0A6Q8PHG1","source":"uniprot_trembl"},{"id":"A0A6Q8PHH4","source":"uniprot_trembl"},{"id":"A0A6Q8PHR8","source":"uniprot_trembl"},{"id":"A0AAQ5BIJ9","source":"uniprot_trembl"},{"id":"F5GX64","source":"uniprot_trembl"},{"id":"H3BRR1","source":"uniprot_trembl"},{"id":"ENSP00000255078","source":"ensembl_PRO"},{"id":"ENSP00000440465","source":"ensembl_PRO"},{"id":"ENSP00000456366","source":"ensembl_PRO"},{"id":"ENSP00000501570","source":"ensembl_PRO"},{"id":"ENSP00000501575","source"