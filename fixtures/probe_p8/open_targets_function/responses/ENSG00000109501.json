{"data":{"target":{"id":"ENSG00000109501","approvedSymbol":"WFS1","functionDescriptions":["Participates in the regulation of cellular Ca(2+) homeostasis, at least partly, by modulating the filling state of the endoplasmic reticulum Ca(2+) store (PubMed:16989814). Negatively regulates the ER stress response and positively regulates the stability of V-ATPase subunits ATP6V1A and ATP1B1 by preventing their degradation through an unknown proteasome-independent mechanism (PubMed:23035048). ."],"proteinIds":[{"id":"O76024","source":"uniprot_swissprot"},{"id":"A0A0S2Z4V6","source":"uniprot_trembl"},{"id":"A0A669KAX3","source":"uniprot_trembl"},{"id":"A0A669KB26","source":"uniprot_trembl"},{"id":"A0A669KBF0","source":"uniprot_trembl"},{"id":"A0A804HIL0","source":"uniprot_trembl"},{"id":"A0A804HIL2","source":"uniprot_trembl"},{"id":"A0A804HK77","source":"uniprot_trembl"},{"id":"A0A804HKM5","source":"uniprot_trembl"},{"id":"H0Y9G5","source":"uniprot_trembl"},{"id":"ENSP00000226760","source":"ensembl_PRO"},{"id":"ENSP00000423337","source":"ensembl_PRO"},{"id":"ENSP00000424103","source":"ensembl_PRO"},{"id":"ENSP00000501033","source":"ensembl_PRO"},{"id":"ENSP00000501083","source":"ensembl_PRO"},{"id":"ENSP00000501242","source":"ensembl_PRO"},{"id":"ENSP00000506978","source":"ensembl_PRO"},{"id":"ENSP00000507120","source":"ensembl_PRO"},{"id":"ENSP00000507124","source":"ensembl_PRO"},{"id":"ENSP00000507806","source":"ensembl_PRO"},{"id":"ENSP00000507852","source":"ensembl_PRO"},{"id":"ENSP00000507988","source":"ensembl_PRO"},{"id":"ENSP00000522086","source":"ensembl_PRO"},{"id":"ENSP00000522087","source":"ensembl_PRO"},{"id":"ENSP00000522088","source":"ensembl_PRO"},{"id":"ENSP00000522089","source":"ensembl_PRO"},{"id":"ENSP00000608579","source":"ensembl_PRO"},{"id":"ENSP00000608580","source":"ensembl_PRO"},{"id":"ENSP00000626638","source":"ensembl_PRO"},{"id":"ENSP00000626639","source":"ensembl_PRO"},{"id":"ENSP00000626640","source":"ensembl_PRO"},{"id":"ENSP00000626641","sour