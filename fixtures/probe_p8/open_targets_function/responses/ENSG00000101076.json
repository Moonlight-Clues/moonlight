{"data":{"target":{"id":"ENSG00000101076","approvedSymbol":"HNF4A","functionDescriptions":["Transcriptional regulator which controls the expression of hepatic genes during the transition of endodermal cells to hepatic progenitor cells, facilitating the recruitment of RNA pol II to the promoters of target genes (PubMed:30597922). Activates the transcription of CYP2C38 (By similarity). Represses the CLOCK-BMAL1 transcriptional activity and is essential for circadian rhythm maintenance and period regulation in the liver and colon cells (PubMed:30530698). {ECO:0000250|UniProtKB:P49698, ECO:0000269|PubMed:30530698, ECO:0000269|PubMed:30597922}."],"proteinIds":[{"id":"P41235","source":"uniprot_swissprot"},{"id":"A0A087WXV4","source":"uniprot_trembl"},{"id":"A0A804HI58","source":"uniprot_trembl"},{"id":"A0A804HIR4","source":"uniprot_trembl"},{"id":"A0A804HJ41","source":"uniprot_trembl"},{"id":"A0A804HJ81","source":"uniprot_trembl"},{"id":"A0A804HJJ6","source":"uniprot_trembl"},{"id":"A0A804HJL7","source":"uniprot_trembl"},{"id":"B9VVT8","source":"uniprot_trembl"},{"id":"F1D8S2","source":"uniprot_trembl"},{"id":"F1D8T0","source":"uniprot_trembl"},{"id":"F1D8T1","source":"uniprot_trembl"},{"id":"F8WBS7","source":"uniprot_trembl"},{"id":"ENSP00000312987","source":"ensembl_PRO"},{"id":"ENSP00000315180","source":"ensembl_PRO"},{"id":"ENSP00000362011","source":"ensembl_PRO"},{"id":"ENSP00000396216","source":"ensembl_PRO"},{"id":"ENSP00000410911","source":"ensembl_PRO"},{"id":"ENSP00000412111","source":"ensembl_PRO"},{"id":"ENSP00000476310","source":"ensembl_PRO"},{"id":"ENSP00000476609","source":"ensembl_PRO"},{"id":"ENSP00000481331","source":"ensembl_PRO"},{"id":"ENSP00000506914","source":"ensembl_PRO"},{"id":"ENSP00000507189","source":"ensembl_PRO"},{"id":"ENSP00000507346","source":"ensembl_PRO"},{"id":"ENSP00000507389","source":"ensembl_PRO"},{"id":"ENSP00000507529","source":"ensembl_PRO"},{"id":"ENSP00000507555","source":"ensembl_PRO"},{"id":"ENSP00000564519","source":"ensem