{"data":{"target":{"id":"ENSG00000159128","approvedSymbol":"IFNGR2","functionDescriptions":["Associates with IFNGR1 to form a receptor for the cytokine interferon gamma (IFNG) (PubMed:7615558, PubMed:7673114, PubMed:8124716). Ligand binding stimulates activation of the JAK/STAT signaling pathway (PubMed:15356148, PubMed:7673114, PubMed:8124716). Required for signal transduction in contrast to other receptor subunit responsible for ligand binding (PubMed:7673114). {ECO:0000269|PubMed:15356148, ECO:0000269|PubMed:7615558, ECO:0000269|PubMed:7673114, ECO:0000269|PubMed:8124716}."],"proteinIds":[{"id":"P38484","source":"uniprot_swissprot"},{"id":"A0A8Q3SIY7","source":"uniprot_trembl"},{"id":"A8K881","source":"uniprot_trembl"},{"id":"B5MCZ0","source":"uniprot_trembl"},{"id":"E7EUY1","source":"uniprot_trembl"},{"id":"F8WE34","source":"uniprot_trembl"},{"id":"F8WF11","source":"uniprot_trembl"},{"id":"H7C1V5","source":"uniprot_trembl"},{"id":"ENSP00000290219","source":"ensembl_PRO"},{"id":"ENSP00000371425","source":"ensembl_PRO"},{"id":"ENSP00000385044","source":"ensembl_PRO"},{"id":"ENSP00000402629","source":"ensembl_PRO"},{"id":"ENSP00000407541","source":"ensembl_PRO"},{"id":"ENSP00000442735","source":"ensembl_PRO"},{"id":"ENSP00000512835","source":"ensembl_PRO"},{"id":"ENSP00000567549","source":"ensembl_PRO"},{"id":"ENSP00000634478","source":"ensembl_PRO"},{"id":"ENSP00000634479","source":"ensembl_PRO"},{"id":"ENSP00000674263","source":"ensembl_PRO"},{"id":"ENSP00000674264","source":"ensembl_PRO"},{"id":"ENSP00000674265","source":"ensembl_PRO"},{"id":"ENSP00000674266","source":"ensembl_PRO"},{"id":"ENSP00000674267","source":"ensembl_PRO"},{"id":"ENSP00000680462","source":"ensembl_PRO"},{"id":"ENSP00000680464","source":"ensembl_PRO"},{"id":"ENSP00000680465","source":"ensembl_PRO"},{"id":"ENSP00000680466","source":"ensembl_PRO"},{"id":"ENSP00000680467","source":"ensembl_PRO"},{"id":"ENSP00000755032","source":"ensembl_PRO"},{"id":"ENSP00000784871","source":"ensembl_PRO"},{"