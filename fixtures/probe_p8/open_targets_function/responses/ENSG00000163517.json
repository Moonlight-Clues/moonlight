{"data":{"target":{"id":"ENSG00000163517","approvedSymbol":"HDAC11","functionDescriptions":["Responsible for the deacetylation of lysine residues on the N-terminal part of the core histones (H2A, H2B, H3 and H4). Histone deacetylation gives a tag for epigenetic repression and plays an important role in transcriptional regulation, cell cycle progression and developmental events. Histone deacetylases act via the formation of large multiprotein complexes. ."],"proteinIds":[{"id":"Q96DB2","source":"uniprot_swissprot"},{"id":"B5MC52","source":"uniprot_trembl"},{"id":"B5MCQ6","source":"uniprot_trembl"},{"id":"B5MCS3","source":"uniprot_trembl"},{"id":"B5MCU6","source":"uniprot_trembl"},{"id":"B5MCV5","source":"uniprot_trembl"},{"id":"B5MD06","source":"uniprot_trembl"},{"id":"C9J528","source":"uniprot_trembl"},{"id":"C9JBI4","source":"uniprot_trembl"},{"id":"C9JEC8","source":"uniprot_trembl"},{"id":"C9JMH0","source":"uniprot_trembl"},{"id":"E7ETT9","source":"uniprot_trembl"},{"id":"F8WF94","source":"uniprot_trembl"},{"id":"Q658J9","source":"uniprot_trembl"},{"id":"ENSP00000295757","source":"ensembl_PRO"},{"id":"ENSP00000384019","source":"ensembl_PRO"},{"id":"ENSP00000384123","source":"ensembl_PRO"},{"id":"ENSP00000384706","source":"ensembl_PRO"},{"id":"ENSP00000385252","source":"ensembl_PRO"},{"id":"ENSP00000385475","source":"ensembl_PRO"},{"id":"ENSP00000385528","source":"ensembl_PRO"},{"id":"ENSP00000395188","source":"ensembl_PRO"},{"id":"ENSP00000396122","source":"ensembl_PRO"},{"id":"ENSP00000398651","source":"ensembl_PRO"},{"id":"ENSP00000399792","source":"ensembl_PRO"},{"id":"ENSP00000401487","source":"ensembl_PRO"},{"id":"ENSP00000402298","source":"ensembl_PRO"},{"id":"ENSP00000411792","source":"ensembl_PRO"},{"id":"ENSP00000412514","source":"ensembl_PRO"},{"id":"ENSP00000429794","source":"ensembl_PRO"},{"id":"ENSP00000531325","source":"ensembl_PRO"},{"id":"ENSP00000531326","source":"ensembl_PRO"},{"id":"ENSP00000531327","source":"ensembl_PRO"},{"id":"ENSP00000531328