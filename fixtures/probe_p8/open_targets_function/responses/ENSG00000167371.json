{"data":{"target":{"id":"ENSG00000167371","approvedSymbol":"PRRT2","functionDescriptions":["As a component of the outer core of AMPAR complex, may be involved in synaptic transmission in the central nervous system. In hippocampal neurons, in presynaptic terminals, plays an important role in the final steps of neurotransmitter release, possibly by regulating Ca(2+)-sensing. In the cerebellum, may inhibit SNARE complex formation and down-regulate short-term facilitation. ."],"proteinIds":[{"id":"Q7Z6L0","source":"uniprot_swissprot"},{"id":"A0A1B0GTE9","source":"uniprot_trembl"},{"id":"A0A1B0GTP1","source":"uniprot_trembl"},{"id":"A0A1B0GTR2","source":"uniprot_trembl"},{"id":"A0A1B0GTS0","source":"uniprot_trembl"},{"id":"A0A1B0GU25","source":"uniprot_trembl"},{"id":"A0A1B0GU37","source":"uniprot_trembl"},{"id":"A0A1B0GUR0","source":"uniprot_trembl"},{"id":"A0A1B0GUW9","source":"uniprot_trembl"},{"id":"H3BN10","source":"uniprot_trembl"},{"id":"ENSP00000300797","source":"ensembl_PRO"},{"id":"ENSP00000351608","source":"ensembl_PRO"},{"id":"ENSP00000454634","source":"ensembl_PRO"},{"id":"ENSP00000456226","source":"ensembl_PRO"},{"id":"ENSP00000458291","source":"ensembl_PRO"},{"id":"ENSP00000489669","source":"ensembl_PRO"},{"id":"ENSP00000489782","source":"ensembl_PRO"},{"id":"ENSP00000489805","source":"ensembl_PRO"},{"id":"ENSP00000489813","source":"ensembl_PRO"},{"id":"ENSP00000489935","source":"ensembl_PRO"},{"id":"ENSP00000489948","source":"ensembl_PRO"},{"id":"ENSP00000490207","source":"ensembl_PRO"},{"id":"ENSP00000490278","source":"ensembl_PRO"},{"id":"ENSP00000490390","source":"ensembl_PRO"},{"id":"ENSP00000490826","source":"ensembl_PRO"},{"id":"ENSP00000498021","source":"ensembl_PRO"},{"id":"ENSP00000531937","source":"ensembl_PRO"},{"id":"ENSP00000808689","source":"ensembl_PRO"},{"id":"A8K8M8","source":"uniprot_obsolete"},{"id":"Q8N2N8","source":"uniprot_obsolete"},{"id":"Q8NAQ7","source":"uniprot_obsolete"},{"id":"Q8ND36","source":"uniprot_obsolete"},{"id":"Q96FA8